# DevAtlas Client Environment Variables (Firebase Web Configuration)
# Safe to include in client bundles. Configure these with your Firebase project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local Development Flag
# Set to 'true' to connect client directly to local Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false

# ==============================================================================
# SERVER-SIDE SECRETS (Cloud Functions 2nd Gen)
# NEVER put these in frontend .env files or client code!
# Set via: firebase functions:secrets:set <KEY>
# ==============================================================================
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GITHUB_TOKEN=
